# Скопировать в .env.local для локальной разработки; на Netlify те же имена
# задаются в Site configuration → Environment variables.
#
# Файл коммитится — значений здесь быть не должно, только имена и пояснения.

# --- База ---------------------------------------------------------------
# DIRECT_URL нужен Prisma для миграций (пул-соединение Neon их не пропускает).
DATABASE_URL=postgresql://dev:dev@localhost:5432/interview_prep
DIRECT_URL=postgresql://dev:dev@localhost:5432/interview_prep

# --- Сессии -------------------------------------------------------------
# Ключ подписи JWT в куке `session` (lib/auth.ts).
JWT_SECRET=

# --- Web Push -----------------------------------------------------------
# Пара ключей VAPID: `npx web-push generate-vapid-keys`.
# Публичный дублируется под именем NEXT_PUBLIC_*, потому что его читает браузер
# при подписке. Приватный — только на сервере, в браузерный бандл он не попадает
# и попасть не должен.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Контакт для push-сервисов, обязателен по спецификации: mailto:… или https://…
VAPID_SUBJECT=mailto:you@example.com

# Общий секрет Netlify Scheduled Function и /api/reminders/run.
# Любая длинная случайная строка: `openssl rand -base64 32`.
CRON_SECRET=

# URL сайта — на Netlify выставляется автоматически, локально нужен, только
# если запускаешь функцию из netlify dev.
# URL=http://localhost:3000

# --- Разное -------------------------------------------------------------
# Корень репозитория с модулями для кнопки «Open in IDE» (по умолчанию ../modules).
# MODULES_ROOT=
