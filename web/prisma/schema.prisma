generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int    @id @default(autoincrement())
  username         String @unique
  passwordHash     String
  dailyReviewLimit Int?

  // Напоминания о повторении. Время и зона — пользовательские, не серверные:
  // Netlify Scheduled Functions ходят по UTC, а «20:30» означает 20:30 там, где
  // человек находится. Сопоставлением занимается lib/reminders.ts.
  remindersEnabled   Boolean   @default(false)
  reminderTime       String    @default("20:30") // HH:MM в локальной зоне
  timezone           String    @default("UTC") // IANA, из Intl.DateTimeFormat()
  lastReminderSentAt DateTime? // якорь идемпотентности: одна отправка в локальные сутки

  theoryProgress    UserTheoryProgress[]
  exerciseProgress  UserExerciseProgress[]
  qaProgress        UserQAProgress[]
  leitnerStates     LeitnerState[]
  reviewLogs        ReviewLog[]
  flashcards        Flashcard[]
  pushSubscriptions PushSubscription[]
}

// Подписка браузера на Web Push. У одного пользователя их несколько: вкладка
// Chrome, установленное PWA и ноутбук — это три разных endpoint'а.
//
// `endpoint` — natural key: браузер может выдать новую подписку на то же
// устройство (после сброса разрешений или переустановки PWA), и запись тогда
// обновляется, а не дублируется.
model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  // false выставляется, когда push-сервис ответил 404/410 — подписки больше
  // нет. Строку не удаляем: повторная подписка тем же браузером оживит её.
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model UserTheoryProgress {
  userId           Int
  theoryDocId      Int
  isRead           Boolean   @default(false)
  readAt           DateTime?
  lastSectionIndex Int?
  lastVisitedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  theoryDoc TheoryDoc @relation(fields: [theoryDocId], references: [id], onDelete: Cascade)

  @@id([userId, theoryDocId])
  @@index([userId, lastVisitedAt])
}

model UserExerciseProgress {
  userId     Int
  exerciseId Int
  isRead     Boolean   @default(false)
  readAt     DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
}

model UserQAProgress {
  userId  Int
  qaId    Int
  isKnown Boolean   @default(false)
  knownAt DateTime?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  qa   InterviewQA @relation(fields: [qaId], references: [id], onDelete: Cascade)

  @@id([userId, qaId])
}

model Module {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  title String
  order Int
  track String @default("architecture")

  theory     TheoryDoc[]
  exercises  Exercise[]
  sections   InterviewSection[]
  qas        InterviewQA[]
  flashcards Flashcard[]
}

model TheoryDoc {
  id             Int      @id @default(autoincrement())
  moduleId       Int
  slug           String
  title          String
  filePath       String
  contentHash    String
  body           String
  order          Int      @default(999)
  sectionCount   Int      @default(0)
  readingMinutes Int      @default(0)

  module         Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userProgress   UserTheoryProgress[]

  @@unique([moduleId, slug])
}

model Exercise {
  id          Int    @id @default(autoincrement())
  moduleId    Int
  slug        String
  number      Int
  title       String
  filePath    String
  contentHash String
  body        String
  language    String @default("kotlin")

  module       Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userProgress UserExerciseProgress[]

  @@unique([moduleId, slug])
}

model InterviewSection {
  id       Int    @id @default(autoincrement())
  moduleId Int
  number   Int
  title    String
  order    Int

  module Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  qas    InterviewQA[]

  @@unique([moduleId, number])
}

model InterviewQA {
  id          Int     @id @default(autoincrement())
  sectionId   Int
  moduleId    Int
  qNumber     Int
  question    String
  answer      String
  sourceRef   String?
  refDocSlug  String?
  refSection  Int?
  contentHash String

  section      InterviewSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  flashcard    Flashcard?
  userProgress UserQAProgress[]

  @@unique([moduleId, qNumber])
  @@index([moduleId, refDocSlug])
}

model Flashcard {
  id        Int      @id @default(autoincrement())
  source    String   // 'AUTO' | 'MANUAL'
  qaId      Int?     @unique
  userId    Int?
  front     String
  back      String
  tags      String   @default("")
  moduleId  Int?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qa            InterviewQA?  @relation(fields: [qaId], references: [id], onDelete: SetNull)
  module        Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  leitnerStates LeitnerState[]
  reviews       ReviewLog[]

  @@index([moduleId])
}

model LeitnerState {
  id             Int       @id @default(autoincrement())
  flashcardId    Int
  userId         Int
  box            Int       @default(1)
  nextDueAt      DateTime
  lastReviewedAt DateTime?
  lapses         Int       @default(0)
  streak         Int       @default(0)

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, nextDueAt])
}

model ReviewLog {
  id          Int      @id @default(autoincrement())
  flashcardId Int
  userId      Int
  reviewedAt  DateTime @default(now())
  prevBox     Int
  newBox      Int
  knewIt      Boolean

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, flashcardId])
  @@index([reviewedAt])
}
